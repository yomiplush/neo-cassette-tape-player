{
  "name": "neo-cassette-tape-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "dev:selfhost": "vite --host 0.0.0.0 --mode selfhost",
    "build:demo": "vite build",
    "build:selfhost": "vite build --mode selfhost",
    "preview:selfhost": "vite preview --host 0.0.0.0 --mode selfhost",
    "test:selfhost": "playwright test --config playwright.selfhost.config.js"
  },
  "devDependencies": {
    "vite": "^7.2.2",
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  }
}
